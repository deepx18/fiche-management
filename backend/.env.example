APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Phase 1 : synchronisation Production depuis Google Sheets ---------
# Lecture seule. Créez un compte de service Google, activez l'API Google
# Sheets, puis partagez le classeur avec l'e-mail du compte de service
# (client_email). Ne versionnez jamais le JSON d'identifiants.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE="A1:Z5000"
GOOGLE_SHEETS_HEADER_ROW=1
GOOGLE_SHEETS_TIMEOUT=30
# Chemin absolu ou relatif au dossier backend/ du JSON de compte de service.
GOOGLE_APPLICATION_CREDENTIALS=storage/app/google/service-account.json

# --- Phase 2 : téléphonie (Kavkom / Issabel) ---------------------------
# Aucune valeur secrète ici. La recherche Kavkom par API n'est pas
# documentée : seuls les CDR poussés par webhook sont ingérés.
KAVKOM_WEBHOOK_ENABLED=false
KAVKOM_WEBHOOK_SECRET=
KAVKOM_WEBHOOK_HEADER="X-Kavkom-Webhook-Token"

# Issabel : connexion MySQL dédiée EN LECTURE SEULE vers asteriskcdrdb,
# et répertoire privé des enregistrements (si accessible par le serveur).
ISSABEL_ENABLED=false
ISSABEL_DB_HOST=127.0.0.1
ISSABEL_DB_PORT=3306
ISSABEL_DB_DATABASE=asteriskcdrdb
ISSABEL_DB_USERNAME=
ISSABEL_DB_PASSWORD=
ISSABEL_CDR_CONNECTION=issabel
ISSABEL_CDR_TABLE=cdr
ISSABEL_CDR_TIMEOUT=10
ISSABEL_CDR_AGENT_COLUMN=
ISSABEL_CDR_DIRECTION_COLUMN=
ISSABEL_RECORDING_ROOT=

# Politique de recherche et stockage privé.
TELEPHONY_SEARCH_DEFAULT_DAYS=30
TELEPHONY_SEARCH_MAX_DAYS=366
TELEPHONY_SEARCH_MAX_RECORDS=50
TELEPHONY_SEARCH_MAX_RESULTS=200
TELEPHONY_RECORDING_DISK=local
TELEPHONY_RECORDING_PATH=recordings
TELEPHONY_RECORDING_MAX_BYTES=52428800
TELEPHONY_RECORDING_RETENTION_DAYS=180
# Délai (minutes) après lequel une récupération « en cours » est considérée
# comme abandonnée (worker arrêté) et peut être relancée.
TELEPHONY_RECORDING_PENDING_TIMEOUT=15

# La recherche et la récupération sont des jobs Laravel : en production
# (QUEUE_CONNECTION=database), un worker doit tourner en permanence.
#   php artisan queue:work --queue=default --tries=3 --timeout=120
# Voir docs/phase-2-telephony.md.
